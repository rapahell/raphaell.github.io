/* ── Modal ── */
function openModal(key) {
  const d = curriculos[key];
  if (!d) return;
  const fotoEl = document.getElementById('modalFoto');
  if (d.foto) {
    fotoEl.innerHTML = `<img src="${d.foto}" alt="${d.nome}">`;
  } else {
    fotoEl.textContent = d.iniciais;
  }
  document.getElementById('modalNome').textContent = d.nome;
  document.getElementById('modalCargo').textContent = d.cargo;
  document.getElementById('modalBody').innerHTML =
    '<div class="modal-tag">Currículo completo</div>' +
    d.bio.map(p => `<p>${p}</p>`).join('');
  document.getElementById('modalOverlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeModal() {
  document.getElementById('modalOverlay').classList.remove('open');
  document.body.style.overflow = '';
}
function closeModalOutside(e) {
  if (e.target === document.getElementById('modalOverlay')) closeModal();
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
